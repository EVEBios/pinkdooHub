Table users {
  id bigint [pk, increment]
  username varchar(32) [not null, unique]
  password varchar(128) [note: 'nullable for external-identity-only users; bcrypt hash when present']
  nickname varchar(32) [not null]
  phone varchar(11) [unique, note: 'nullable for external-identity-only users']
  avatar varchar(256)
  role smallint [not null, note: 'ORM default 1; 1:user 2:admin 3:super_admin']
  status smallint [not null, note: 'ORM default 1; 1:normal 2:disabled 3:deleted']
  last_login_at datetime
  auth_version int [not null, default: 0, note: 'invalidates older access/refresh sessions after credential changes']
  deleted_at datetime [note: 'UTC account anonymization timestamp']
  created_at datetime
  updated_at datetime

  indexes {
    (status, role) [name: 'idx_users_status_role']
  }
}

Table external_identities {
  id bigint [pk, increment]
  provider varchar(32) [not null, note: 'wechat_miniprogram in Phase 9.5']
  app_id varchar(64) [not null]
  subject_id varchar(128) [not null, note: 'HMAC-SHA256 hex; never raw OpenID']
  union_id varchar(128) [note: 'nullable HMAC-SHA256 hex; never raw UnionID']
  user_id bigint [not null]
  created_at datetime
  updated_at datetime

  indexes {
    (provider, app_id, subject_id) [unique, name: 'uidx_external_identity_subject']
    (provider, union_id) [unique, name: 'uidx_external_identity_union']
    (user_id, provider, created_at) [name: 'idx_external_identity_user_provider']
  }
}

Ref: external_identities.user_id > users.id [delete: restrict]

// ── Product ────────────────────────────────────

Table products {
  id bigint [pk, increment]
  name varchar(100) [not null, note: 'allow duplicate']
  product_type varchar(20) [not null, note: 'experience | kit, immutable after create. Python 3.10 uses ProductType(str, Enum) — no magic strings']
  description text
  status varchar(20) [not null, default: 'draft', note: 'draft | online | offline. Python 3.10 uses ProductStatus(str, Enum)']
  is_deleted boolean [not null, default: false, note: 'logical delete']
  created_at datetime
  updated_at datetime

  indexes {
    (status, is_deleted) [name: 'idx_products_status_deleted']
  }
}

Table experience_options {
  id bigint [pk, increment]
  product_id bigint [not null]
  duration int [not null, note: 'positive minutes; 60 | 120 | 540 are current common values']
  participants int [not null, note: 'positive integer; 1 | 2 are current common values']
  day_type varchar(20) [not null, note: 'weekday | holiday']
  price decimal(10,2) [not null]
  is_deleted boolean [not null, default: false, note: 'logical delete; preserve FK references']

  // Data Consistency: (product_id + duration + participants + day_type) UNIQUE
  // Aggregate Rule: online product must have >= 1 option (is_deleted = false)
  // Lifecycle: no independent status; follows product lifecycle

  created_at datetime
  updated_at datetime

  indexes {
    (product_id, duration, participants, day_type) [unique, name: 'idx_option_unique', note: 'unique across all rows; restore the same row after logical deletion']
  }
}

Table product_kits {
  id bigint [pk, increment]
  product_id bigint [not null, unique]
  price decimal(10,2) [not null, note: 'kit product price']
  stock int [not null, default: 0, note: 'authoritative balance; application range 0..999999; every Phase 4.3 change writes a ledger row in the same transaction']
  created_at datetime
  updated_at datetime
}

Table product_images {
  id bigint [pk, increment]
  product_id bigint [not null]
  experience_option_id bigint [note: 'NULL = Product public image; non-NULL = Option-specific image']
  image_url varchar(2048) [not null]
  is_cover boolean [not null, default: false, note: 'only meaningful when experience_option_id IS NULL']
  sort int [not null, default: 0]
  is_deleted boolean [not null, default: false, note: 'logical delete']
  created_at datetime
  updated_at datetime

  indexes {
    (product_id, sort) [name: 'idx_image_product_sort']
    (product_id, is_cover) [name: 'idx_image_product_cover']
    (experience_option_id, sort) [name: 'idx_image_option_sort']
  }
}

// Product child FKs use RESTRICT. The nullable Option-image FK uses SET NULL only as a physical-delete fallback.
Ref: experience_options.product_id > products.id [delete: restrict]
Ref: product_kits.product_id > products.id [delete: restrict]
Ref: product_images.product_id > products.id [delete: restrict]
Ref: product_images.experience_option_id > experience_options.id [delete: set null]

// ── Audit Log ──────────────────────────────────

Table audit_logs {
  id bigint [pk, increment]
  operator_id bigint [not null, note: 'who performed the action']
  action varchar(50) [not null, note: 'CREATE_PRODUCT | CREATE_ORDER | PAY_ORDER | ADJUST_WALLET | REFUND_ORDER | ...']
  target_type varchar(50) [not null, note: 'product | user | order | wallet']
  target_id bigint [not null]
  description varchar(256) [note: 'e.g. price changed: 299 → 399']
  ip_address varchar(45) [not null]
  created_at datetime
  updated_at datetime

  indexes {
    (target_type, target_id, created_at) [name: 'idx_audit_target_created']
    (operator_id, created_at) [name: 'idx_audit_operator_created']
  }
}

// ── Order (v1.0 frozen contract, Phase 4.2 Models implemented) ──

Table orders {
  id bigint [pk, increment]
  order_no varchar(28) [not null, unique, note: 'OD + 26-char uppercase Crockford Base32 ULID']
  user_id bigint [not null]
  total_amount decimal(10,2) [not null]
  status smallint [not null, default: 0, note: 'OrderStatus(IntEnum): 0:pending 1:paid 2:cancelled 3:completed']
  remark varchar(500)
  created_at datetime
  updated_at datetime

  indexes {
    (user_id, created_at, id) [name: 'idx_orders_user_created_id']
    (user_id, status, created_at, id) [name: 'idx_orders_user_status_created_id']
    (status, created_at, id) [name: 'idx_orders_status_created_id']
    (created_at, id) [name: 'idx_orders_created_id']
  }
}

// Lifecycle: pending -> cancelled | paid; paid -> completed.
// Payment integration records a unique successful settlement for wallet/manual Paid transitions.
// Phase 4.3 accepts Experience, Kit, and mixed orders. Pending Kit items deduct
// ProductKit.stock atomically; Pending cancellation and PAID full refund restore it.
// ADMIN+ assisted wallet orders deduct once at creation and are committed directly as Paid.

Table order_items {
  id bigint [pk, increment]
  order_id bigint [not null]
  product_id bigint [not null]

  // Experience items reference an option; Kit items keep all option fields NULL.
  experience_option_id bigint [note: 'FK to experience_options; NULL for kit products']
  option_duration_minutes int [note: 'snapshot: positive minutes']
  option_participants int [note: 'snapshot: positive participants']
  option_day_type varchar(20) [note: 'snapshot: weekday | holiday']

  product_name varchar(100) [not null, note: 'snapshot: product name at order time']
  product_price decimal(10,2) [not null, note: 'snapshot: price at order time']
  quantity int [not null, note: 'Phase 4.2 application range: 1..99']
  subtotal decimal(10,2) [not null]
  created_at datetime
  updated_at datetime

  indexes {
    (order_id, id) [name: 'idx_order_items_order_id']
  }
}

// Historical order references are protected from physical deletion.
Ref: orders.user_id > users.id [delete: restrict]
Ref: order_items.order_id > orders.id [delete: restrict]
Ref: order_items.product_id > products.id [delete: restrict]
Ref: order_items.experience_option_id > experience_options.id [delete: restrict]

// ── Wallet / Payment / Refund (M4 offline migration generated; not applied) ──

Table wallet_accounts {
  id bigint [pk, increment]
  user_id bigint [not null, unique, note: 'ordinary USER only; runtime NORMAL/DISABLED users have one; legacy DELETED users may have none; ADMIN/SUPER_ADMIN do not own wallets']
  balance decimal(10,2) [not null, default: 0.00, note: 'authoritative balance; application range 0.00..1000.00; positive credits also preserve derived refundable wallet exposure']
  status varchar(32) [not null, default: 'active', note: 'active | closed']
  created_at datetime
  updated_at datetime
}

Table wallet_transactions {
  id bigint [pk, increment]
  wallet_account_id bigint [not null]
  transaction_type varchar(32) [not null, note: 'recharge | order_payment | admin_adjustment | refund']
  change_amount decimal(10,2) [not null, note: 'application range -1000.00..1000.00, non-zero']
  before_balance decimal(10,2) [not null, note: 'application range 0.00..1000.00']
  after_balance decimal(10,2) [not null, note: 'equals before_balance + change_amount; range 0.00..1000.00']
  source_type varchar(32) [not null, note: 'recharge_order | order | admin | refund']
  source_id bigint [note: 'polymorphic business source; deliberately no FK']
  operator_id bigint
  reason varchar(256) [not null]
  idempotency_key varchar(256) [not null, note: 'internal namespaced identity; MySQL ascii_bin bytewise comparison; never exposed by API']
  created_at datetime
  updated_at datetime [note: 'BaseModel technical field; ledger has no business update path']

  indexes {
    (idempotency_key) [unique, name: 'uidx_wallet_transaction_idempotency']
    (wallet_account_id, created_at, id) [name: 'idx_wallet_transaction_wallet_created_id']
    (source_type, source_id, created_at, id) [name: 'idx_wallet_transaction_source_created_id']
    (transaction_type, created_at, id) [name: 'idx_wallet_transaction_type_created_id']
    (created_at, id) [name: 'idx_wallet_transaction_created_id']
  }
}

Table recharge_orders {
  id bigint [pk, increment]
  recharge_no varchar(28) [not null, unique, note: 'RC + 26-char uppercase Crockford Base32 ULID']
  user_id bigint [not null]
  wallet_account_id bigint [not null]
  amount decimal(10,2) [not null, note: 'application range 1.00..1000.00 inclusive']
  status varchar(32) [not null, default: 'pending', note: 'pending | paid | failed | closed']
  idempotency_key varchar(256) [not null, note: 'MySQL ascii_bin bytewise comparison']
  succeeded_at datetime
  created_at datetime
  updated_at datetime

  indexes {
    (idempotency_key) [unique, name: 'uidx_recharge_order_idempotency']
    (user_id, created_at, id) [name: 'idx_recharge_order_user_created_id']
    (status, created_at, id) [name: 'idx_recharge_order_status_created_id']
  }
}

Table payments {
  id bigint [pk, increment]
  payment_no varchar(28) [not null, unique, note: 'PY + 26-char uppercase Crockford Base32 ULID']
  user_id bigint [not null]
  purpose varchar(32) [not null, note: 'order | recharge']
  method varchar(32) [not null, note: 'wallet | wechat | manual']
  amount decimal(10,2) [not null]
  status varchar(32) [not null, default: 'pending', note: 'pending | succeeded | failed | closed']
  order_id bigint
  recharge_order_id bigint
  idempotency_key varchar(256) [not null, note: 'MySQL ascii_bin bytewise comparison']
  provider_transaction_id varchar(128)
  succeeded_at datetime
  created_at datetime
  updated_at datetime

  indexes {
    (idempotency_key) [unique, name: 'uidx_payment_idempotency']
    (provider_transaction_id) [unique, name: 'uidx_payment_provider_transaction']
    (user_id, created_at, id) [name: 'idx_payment_user_created_id']
    (order_id, created_at, id) [name: 'idx_payment_order_created_id']
    (recharge_order_id, created_at, id) [name: 'idx_payment_recharge_created_id']
    (status, created_at, id) [name: 'idx_payment_status_created_id']
  }
}

Table payment_settlements {
  id bigint [pk, increment]
  payment_id bigint [not null, unique]
  order_id bigint [not null, unique]
  amount decimal(10,2) [not null, note: 'must equal successful Payment and Order total; refundable wallet exposure is derived from settlement/payment/order/refund state, not stored']
  created_at datetime
  updated_at datetime
}

Table refunds {
  id bigint [pk, increment]
  refund_no varchar(28) [not null, unique, note: 'RF + 26-char uppercase Crockford Base32 ULID']
  settlement_id bigint [not null, unique]
  order_id bigint [not null, unique]
  operator_id bigint [not null]
  amount decimal(10,2) [not null, note: 'v1 full settlement amount only']
  status varchar(32) [not null, default: 'pending', note: 'pending | succeeded | failed; succeeded releases refundable wallet exposure']
  inventory_restored boolean [not null, default: false, note: 'true only for restored PAID Kit/mixed orders']
  reason varchar(256) [not null]
  idempotency_key varchar(256) [not null, note: 'MySQL ascii_bin bytewise comparison']
  provider_refund_id varchar(128)
  succeeded_at datetime
  created_at datetime
  updated_at datetime

  indexes {
    (idempotency_key) [unique, name: 'uidx_refund_idempotency']
    (provider_refund_id) [unique, name: 'uidx_refund_provider_reference']
    (order_id, created_at, id) [name: 'idx_refund_order_created_id']
    (status, created_at, id) [name: 'idx_refund_status_created_id']
  }
}

Ref: wallet_accounts.user_id > users.id [delete: restrict]
Ref: wallet_transactions.wallet_account_id > wallet_accounts.id [delete: restrict]
Ref: wallet_transactions.operator_id > users.id [delete: restrict]
Ref: recharge_orders.user_id > users.id [delete: restrict]
Ref: recharge_orders.wallet_account_id > wallet_accounts.id [delete: restrict]
Ref: payments.user_id > users.id [delete: restrict]
Ref: payments.order_id > orders.id [delete: restrict]
Ref: payments.recharge_order_id > recharge_orders.id [delete: restrict]
Ref: payment_settlements.payment_id > payments.id [delete: restrict]
Ref: payment_settlements.order_id > orders.id [delete: restrict]
Ref: refunds.settlement_id > payment_settlements.id [delete: restrict]
Ref: refunds.order_id > orders.id [delete: restrict]
Ref: refunds.operator_id > users.id [delete: restrict]

// ── Inventory (Phase 4.3.4 MySQL migration generated offline; not applied) ──

Table inventory_transactions {
  id bigint [pk, increment]
  product_id bigint [not null, note: 'public Kit Product ID; balance row is product_kits']
  transaction_type varchar(40) [not null, note: 'opening_balance | admin_adjustment | order_deduction | order_cancellation_restore | order_refund_restore']
  change_quantity int [not null, note: 'application range -999999..999999, non-zero']
  before_quantity int [not null, note: 'application range 0..999999']
  after_quantity int [not null, note: 'application range 0..999999; equals before_quantity + change_quantity']
  source_type varchar(30) [not null, note: 'migration | admin | order']
  source_id bigint [note: 'Order ID only when source_type=order; deliberately no polymorphic FK']
  operator_id bigint [note: 'triggering user; nullable for migration or future system events']
  reason varchar(256) [not null, note: 'normalized admin reason or server-defined stable event reason']
  idempotency_key varchar(256) [not null, note: 'internal namespaced business identity; never exposed by API']
  created_at datetime
  updated_at datetime [note: 'BaseModel technical field; ledger has no business update path']

  indexes {
    (idempotency_key) [unique, name: 'uidx_inventory_idempotency_key']
    (product_id, created_at, id) [name: 'idx_inventory_product_created_id']
    (source_type, source_id, created_at, id) [name: 'idx_inventory_source_created_id']
    (transaction_type, created_at, id) [name: 'idx_inventory_type_created_id']
    (created_at, id) [name: 'idx_inventory_created_id']
  }
}

Ref: inventory_transactions.product_id > products.id [delete: restrict]
Ref: inventory_transactions.operator_id > users.id [delete: restrict]
