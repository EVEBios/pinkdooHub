Table users {
  id bigint [pk, increment]
  username varchar [not null, unique]
  password varchar [not null]
  nickname varchar
  phone varchar [unique]
  avatar varchar
  role tinyint [default: 1, note: '1:user 2:admin 3:super_admin']
  status tinyint [default: 1, note: '1:normal 2:disabled']
  last_login_at datetime
  created_at datetime
  updated_at datetime

  indexes {
    (status, role) [name: 'idx_users_status_role']
  }
}

// ── Product ────────────────────────────────────

Table products {
  id bigint [pk, increment]
  name varchar [not null, note: 'max 100 chars, allow duplicate']
  product_type varchar [not null, note: 'experience | kit, immutable after create. DB uses varchar; Python MUST use ProductType(StrEnum) — no magic strings']
  description text
  status varchar [not null, default: 'draft', note: 'draft | online | offline. DB uses varchar; Python MUST use ProductStatus(StrEnum)']
  is_deleted boolean [default: false, note: 'logical delete']
  created_at datetime
  updated_at datetime

  indexes {
    (status, is_deleted) [name: 'idx_products_status_deleted']
  }
}

Table experience_options {
  id bigint [pk, increment]
  product_id bigint [not null]
  duration int [not null, note: '60 | 120 | 480 (minutes)']
  participants int [not null, note: '1 | 2']
  day_type varchar [not null, note: 'weekday | holiday']
  price decimal(10,2) [not null]
  sort int [default: 0, note: 'display order, e.g. 10/20/30, gap for future insert']

  // Data Consistency: (product_id + duration + participants + day_type) UNIQUE
  // Aggregate Rule: online product must have >= 1 option
  // Lifecycle: no independent status; follows product lifecycle

  created_at datetime
  updated_at datetime

  indexes {
    (product_id, duration, participants, day_type) [unique, name: 'idx_option_unique']
    (product_id, sort) [name: 'idx_option_product_sort']
  }
}

Table product_kits {
  id bigint [pk, increment]
  product_id bigint [not null, unique]
  price decimal(10,2) [not null, note: 'kit product price']
  stock int [not null, default: 0]
  sold_count int [default: 0]
  created_at datetime
  updated_at datetime
}

Table product_images {
  id bigint [pk, increment]
  product_id bigint [not null]
  experience_option_id bigint [note: 'NULL = Product public image; non-NULL = Option-specific image']
  image_url varchar [not null]
  is_cover boolean [default: false, note: 'only meaningful when experience_option_id IS NULL']
  sort int [default: 0]
  created_at datetime
  updated_at datetime

  indexes {
    (product_id, sort) [name: 'idx_image_product_sort']
    (product_id, is_cover) [name: 'idx_image_product_cover']
    (experience_option_id, sort) [name: 'idx_image_option_sort']
  }
}

// FK: ON DELETE RESTRICT — prevent bypassing logical delete
Ref: experience_options.product_id > products.id [delete: restrict]
Ref: product_kits.product_id > products.id [delete: restrict]
Ref: product_images.product_id > products.id [delete: restrict]
Ref: product_images.experience_option_id > experience_options.id [delete: set null]

// ── Audit Log ──────────────────────────────────

Table audit_logs {
  id bigint [pk, increment]
  operator_id bigint [not null, note: 'who performed the action']
  action varchar [not null, note: 'CREATE_PRODUCT | UPDATE_PRICE | ONLINE_PRODUCT | ...']
  target_type varchar [not null, note: 'product | user']
  target_id bigint [not null]
  description varchar [note: 'e.g. price changed: 299 → 399']
  ip_address varchar [not null]
  created_at datetime

  indexes {
    (target_type, target_id, created_at) [name: 'idx_audit_target_created']
    (operator_id, created_at) [name: 'idx_audit_operator_created']
  }
}

// ── Order (placeholder, Phase 4.2) ──────────────

Table orders {
  id bigint [pk, increment]
  order_no varchar [not null, unique, note: 'order number']
  user_id bigint [not null]
  total_amount decimal(10,2) [not null]
  status tinyint [not null, default: 0, note: '0:pending 1:paid 2:cancelled 3:completed']
  remark varchar
  created_at datetime
  updated_at datetime

  indexes {
    (user_id, status, created_at) [name: 'idx_orders_user_status_created']
    (status, created_at) [name: 'idx_orders_status_created']
  }
}

Table order_items {
  id bigint [pk, increment]
  order_id bigint [not null]
  product_id bigint [not null]

  // Experience option snapshot (nullable — kit products don't use these)
  experience_option_id bigint [note: 'FK to experience_options, nullable for kit products']
  option_duration int [note: 'snapshot: 60 | 120 | 480 (minutes)']
  option_participants int [note: 'snapshot: 1 | 2']
  option_day_type varchar [note: 'snapshot: weekday | holiday']

  product_name varchar [not null, note: 'snapshot: product name at order time']
  product_price decimal(10,2) [not null, note: 'snapshot: price at order time']
  quantity int [not null, default: 1]
  subtotal decimal(10,2) [not null]
  created_at datetime
  updated_at datetime

  indexes {
    (order_id) [name: 'idx_order_items_order']
  }
}

Ref: orders.user_id > users.id
Ref: order_items.order_id > orders.id
Ref: order_items.product_id > products.id
Ref: order_items.experience_option_id > experience_options.id
