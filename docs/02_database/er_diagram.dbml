Table users {
  id bigint [pk, increment]
  username varchar(32) [not null, unique]
  password varchar(128) [not null]
  nickname varchar(32) [not null]
  phone varchar(11) [not null, unique]
  avatar varchar(256)
  role smallint [not null, note: 'ORM default 1; 1:user 2:admin 3:super_admin']
  status smallint [not null, note: 'ORM default 1; 1:normal 2:disabled']
  last_login_at datetime
  created_at datetime
  updated_at datetime

  indexes {
    (status, role) [name: 'idx_users_status_role']
  }
}

// ── Product ────────────────────────────────────

Table products {
  id bigint [pk, increment]
  name varchar(100) [not null, note: 'allow duplicate']
  product_type varchar(20) [not null, note: 'experience | kit, immutable after create. Python 3.10 uses ProductType(str, Enum) — no magic strings']
  description text
  status varchar(20) [not null, default: 'draft', note: 'draft | online | offline. Python 3.10 uses ProductStatus(str, Enum)']
  is_deleted boolean [not null, default: false, note: 'logical delete']
  created_at datetime
  updated_at datetime

  indexes {
    (status, is_deleted) [name: 'idx_products_status_deleted']
  }
}

Table experience_options {
  id bigint [pk, increment]
  product_id bigint [not null]
  duration int [not null, note: 'positive minutes; 60 | 120 | 540 are current common values']
  participants int [not null, note: 'positive integer; 1 | 2 are current common values']
  day_type varchar(20) [not null, note: 'weekday | holiday']
  price decimal(10,2) [not null]
  is_deleted boolean [not null, default: false, note: 'logical delete; preserve FK references']

  // Data Consistency: (product_id + duration + participants + day_type) UNIQUE
  // Aggregate Rule: online product must have >= 1 option (is_deleted = false)
  // Lifecycle: no independent status; follows product lifecycle

  created_at datetime
  updated_at datetime

  indexes {
    (product_id, duration, participants, day_type) [unique, name: 'idx_option_unique', note: 'unique across all rows; restore the same row after logical deletion']
  }
}

Table product_kits {
  id bigint [pk, increment]
  product_id bigint [not null, unique]
  price decimal(10,2) [not null, note: 'kit product price']
  stock int [not null, default: 0, note: 'authoritative balance; application range 0..999999; every Phase 4.3 change writes a ledger row in the same transaction']
  created_at datetime
  updated_at datetime
}

Table product_images {
  id bigint [pk, increment]
  product_id bigint [not null]
  experience_option_id bigint [note: 'NULL = Product public image; non-NULL = Option-specific image']
  image_url varchar(2048) [not null]
  is_cover boolean [not null, default: false, note: 'only meaningful when experience_option_id IS NULL']
  sort int [not null, default: 0]
  is_deleted boolean [not null, default: false, note: 'logical delete']
  created_at datetime
  updated_at datetime

  indexes {
    (product_id, sort) [name: 'idx_image_product_sort']
    (product_id, is_cover) [name: 'idx_image_product_cover']
    (experience_option_id, sort) [name: 'idx_image_option_sort']
  }
}

// Product child FKs use RESTRICT. The nullable Option-image FK uses SET NULL only as a physical-delete fallback.
Ref: experience_options.product_id > products.id [delete: restrict]
Ref: product_kits.product_id > products.id [delete: restrict]
Ref: product_images.product_id > products.id [delete: restrict]
Ref: product_images.experience_option_id > experience_options.id [delete: set null]

// ── Audit Log ──────────────────────────────────

Table audit_logs {
  id bigint [pk, increment]
  operator_id bigint [not null, note: 'who performed the action']
  action varchar(50) [not null, note: 'CREATE_PRODUCT | UPDATE_PRICE | ONLINE_PRODUCT | ...']
  target_type varchar(50) [not null, note: 'product | user']
  target_id bigint [not null]
  description varchar(256) [note: 'e.g. price changed: 299 → 399']
  ip_address varchar(45) [not null]
  created_at datetime
  updated_at datetime

  indexes {
    (target_type, target_id, created_at) [name: 'idx_audit_target_created']
    (operator_id, created_at) [name: 'idx_audit_operator_created']
  }
}

// ── Order (v1.0 frozen contract, Phase 4.2 Models implemented) ──

Table orders {
  id bigint [pk, increment]
  order_no varchar(28) [not null, unique, note: 'OD + 26-char uppercase Crockford Base32 ULID']
  user_id bigint [not null]
  total_amount decimal(10,2) [not null]
  status smallint [not null, default: 0, note: 'OrderStatus(IntEnum): 0:pending 1:paid 2:cancelled 3:completed']
  remark varchar(500)
  created_at datetime
  updated_at datetime

  indexes {
    (user_id, created_at, id) [name: 'idx_orders_user_created_id']
    (user_id, status, created_at, id) [name: 'idx_orders_user_status_created_id']
    (status, created_at, id) [name: 'idx_orders_status_created_id']
    (created_at, id) [name: 'idx_orders_created_id']
  }
}

// Lifecycle: pending -> cancelled | paid; paid -> completed.
// Phase 4.2 payment entry is ADMIN+ manual confirmation until Payment integration.
// Phase 4.3 accepts Experience, Kit, and mixed orders. Pending Kit items
// deduct ProductKit.stock atomically and Pending cancellation restores it.

Table order_items {
  id bigint [pk, increment]
  order_id bigint [not null]
  product_id bigint [not null]

  // Experience items reference an option; Kit items keep all option fields NULL.
  experience_option_id bigint [note: 'FK to experience_options; NULL for kit products']
  option_duration_minutes int [note: 'snapshot: positive minutes']
  option_participants int [note: 'snapshot: positive participants']
  option_day_type varchar(20) [note: 'snapshot: weekday | holiday']

  product_name varchar(100) [not null, note: 'snapshot: product name at order time']
  product_price decimal(10,2) [not null, note: 'snapshot: price at order time']
  quantity int [not null, note: 'Phase 4.2 application range: 1..99']
  subtotal decimal(10,2) [not null]
  created_at datetime
  updated_at datetime

  indexes {
    (order_id, id) [name: 'idx_order_items_order_id']
  }
}

// Historical order references are protected from physical deletion.
Ref: orders.user_id > users.id [delete: restrict]
Ref: order_items.order_id > orders.id [delete: restrict]
Ref: order_items.product_id > products.id [delete: restrict]
Ref: order_items.experience_option_id > experience_options.id [delete: restrict]

// ── Inventory (Phase 4.3.4 MySQL migration generated offline; not applied) ──

Table inventory_transactions {
  id bigint [pk, increment]
  product_id bigint [not null, note: 'public Kit Product ID; balance row is product_kits']
  transaction_type varchar(40) [not null, note: 'opening_balance | admin_adjustment | order_deduction | order_cancellation_restore']
  change_quantity int [not null, note: 'application range -999999..999999, non-zero']
  before_quantity int [not null, note: 'application range 0..999999']
  after_quantity int [not null, note: 'application range 0..999999; equals before_quantity + change_quantity']
  source_type varchar(30) [not null, note: 'migration | admin | order']
  source_id bigint [note: 'Order ID only when source_type=order; deliberately no polymorphic FK']
  operator_id bigint [note: 'triggering user; nullable for migration or future system events']
  reason varchar(256) [not null, note: 'normalized admin reason or server-defined stable event reason']
  idempotency_key varchar(256) [not null, note: 'internal namespaced business identity; never exposed by API']
  created_at datetime
  updated_at datetime [note: 'BaseModel technical field; ledger has no business update path']

  indexes {
    (idempotency_key) [unique, name: 'uidx_inventory_idempotency_key']
    (product_id, created_at, id) [name: 'idx_inventory_product_created_id']
    (source_type, source_id, created_at, id) [name: 'idx_inventory_source_created_id']
    (transaction_type, created_at, id) [name: 'idx_inventory_type_created_id']
    (created_at, id) [name: 'idx_inventory_created_id']
  }
}

Ref: inventory_transactions.product_id > products.id [delete: restrict]
Ref: inventory_transactions.operator_id > users.id [delete: restrict]
