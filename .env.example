# ═══════════════════════════════════════════════
# pinkdooHub 配置模板
# ═══════════════════════════════════════════════
# 使用方法：cp .env.example .env 然后修改

# ── 应用 ──────────────────────────────────────
APP_NAME=pinkdooHub
APP_VERSION=0.6.0
APP_ENV=development
APP_DEBUG=true

# ── 数据库 ────────────────────────────────────
# sqlite: 开发环境，零配置
# mysql:  生产环境
DB_ENGINE=sqlite
DB_SQLITE_PATH=./db.sqlite3
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pinkdoohub

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Product 图片存储 ───────────────────────────────
# 开发环境使用本地目录，并由应用挂载静态访问路由
PRODUCT_IMAGE_UPLOAD_DIR=./uploads/products
PRODUCT_IMAGE_BASE_URL=/uploads/products

# ── JWT ───────────────────────────────────────
# 生产环境用 openssl rand -hex 32 生成
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE=7200
JWT_REFRESH_TOKEN_EXPIRE=604800

# ── Phase 9.5 公开身份与认证安全 ───────────────
# Gate A 默认保留密码模式且不启用微信；Gate B 由服务端 Secret 系统注入
PASSWORD_REGISTRATION_ENABLED=true
WECHAT_LOGIN_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 与 JWT Secret 分离；生产启用微信时必须是稳定、至少 32 字符的 Secret
EXTERNAL_IDENTITY_PEPPER=change-me
WECHAT_API_TIMEOUT_SECONDS=5

AUTH_LOGIN_IP_LIMIT=20
AUTH_LOGIN_SUBJECT_LIMIT=8
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_REGISTER_IP_LIMIT=5
AUTH_REGISTER_WINDOW_SECONDS=3600
AUTH_REFRESH_LIMIT=30
AUTH_REFRESH_WINDOW_SECONDS=60
AUTH_WECHAT_LOGIN_LIMIT=10
AUTH_WECHAT_LOGIN_WINDOW_SECONDS=300
AUTH_WECHAT_BIND_LIMIT=5
AUTH_WECHAT_BIND_WINDOW_SECONDS=600
