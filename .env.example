# ═══════════════════════════════════════════════
# pinkdooHub 配置模板
# ═══════════════════════════════════════════════
# 使用方法：cp .env.example .env 然后修改

# ── 应用 ──────────────────────────────────────
APP_NAME=pinkdooHub
APP_VERSION=0.3.0
APP_ENV=development
APP_DEBUG=true

# ── 数据库 ────────────────────────────────────
# sqlite: 开发环境，零配置
# mysql:  生产环境
DB_ENGINE=sqlite
DB_SQLITE_PATH=./db.sqlite3
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pinkdoohub

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ───────────────────────────────────────
# 生产环境用 openssl rand -hex 32 生成
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE=7200
JWT_REFRESH_TOKEN_EXPIRE=604800
