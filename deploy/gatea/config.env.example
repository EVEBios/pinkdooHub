# Pass this file to Docker Compose with --env-file after copying it to the
# root-owned Gate A configuration path. It contains no Secret values.
GATEA_APP_IMAGE=pinkdoohub-gatea:REPLACE_WITH_GIT_SHA
GATEA_CONFIG_FILE=/etc/pinkdoohub/gatea/config.env
GATEA_SECRET_DIR=/etc/pinkdoohub/gatea/secrets
GATEA_LOOPBACK_PORT=18080
GATEA_API_HOST=api-test.pinkdoohub.cn
GATEA_LETSENCRYPT_DIR=/etc/letsencrypt
GATEA_ACME_CHALLENGE_DIR=/srv/pinkdoohub/gatea/acme
GATEA_BACKUP_ROOT=/srv/pinkdoohub/gatea/backups

APP_NAME=pinkdooHub
APP_VERSION=0.6.0
APP_ENV=production
APP_DEBUG=false

DB_ENGINE=mysql
DB_HOST=mysql
DB_PORT=3306
DB_NAME=pinkdoohub_gatea
DB_USER=pinkdoo_app

PRODUCT_IMAGE_UPLOAD_DIR=/data/images
PRODUCT_IMAGE_BASE_URL=https://api-test.pinkdoohub.cn/uploads/products

# Gate A 尚未接入微信支付；资金能力默认全部关闭。
WALLET_ADMIN_WRITE_ENABLED=false
WALLET_ORDER_PAYMENT_ENABLED=false
WALLET_REFUND_ENABLED=false
WALLET_TOPUP_ENABLED=false
PAYMENT_PROVIDER=disabled

# M9 内部验收开关；正式公开二维码与生产发布前必须重新评审。
TABLE_SESSION_CLAIMS_ENABLED=true

JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE=7200
JWT_REFRESH_TOKEN_EXPIRE=604800

# Non-Secret bootstrap identity. Fill these only for the approved one-time run.
GATEA_BOOTSTRAP_USERNAME=REPLACE_WITH_APPROVED_USERNAME
GATEA_BOOTSTRAP_NICKNAME=REPLACE_WITH_APPROVED_NICKNAME
GATEA_BOOTSTRAP_PHONE=REPLACE_WITH_APPROVED_PHONE
